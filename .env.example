# AIWerkstatt configuration — copy to `.env`. Every value has a sensible default;
# the app runs fine with an empty .env. NEVER put real API keys here — you add
# provider keys in the browser after first start (they are stored encrypted in
# the app's private volume, never in the repo).

# Port the web UI is served on (http://localhost:<port>).
AIWERKSTATT_PORT=8095

# Host port range handed to the web apps that agents build & deploy live.
AIWERKSTATT_PORT_RANGE=8100-8199

# Host name the browser uses to reach a deployed app. Keep "localhost" for a
# personal install; set to your machine's LAN/VPN name to reach it from phones.
AIWERKSTATT_PUBLIC_HOST=localhost

# First-run admin. Create the real password (PIN) in the browser on first start.
AIWERKSTATT_ADMIN=admin
AIWERKSTATT_ADMIN_PIN=1234

# Auto-retry an aborted agent run at most this many times, with a growing pause
# (5, 15, then 45 min). 0 = no attempt limit; retries still stop 12 h after the request.
AIWERKSTATT_MAX_RETRIES=3
