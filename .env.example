# AIWerkstatt configuration — copy to `.env`. Every value has a sensible default;
# the app runs fine with an empty .env. NEVER put real API keys here — you add
# provider keys in the browser after first start (they are stored encrypted in
# the app's private volume, never in the repo).

# Port the web UI is served on (http://localhost:<port>).
AIWERKSTATT_PORT=8095

# Host port range handed to the web apps that agents build & deploy live.
AIWERKSTATT_PORT_RANGE=8100-8199

# Host name the browser uses to reach a deployed app. Keep "localhost" for a
# personal install; set to your machine's LAN/VPN name to reach it from phones.
AIWERKSTATT_PUBLIC_HOST=localhost

# First-run admin. Create the real password (PIN) in the browser on first start.
AIWERKSTATT_ADMIN=admin
AIWERKSTATT_ADMIN_PIN=1234

# Auto-retry an aborted agent run at most this many times, with a growing pause
# (5, 15, then 45 min). 0 = no attempt limit; retries still stop 12 h after the request.
AIWERKSTATT_MAX_RETRIES=3

# At most this many agent runs at the same time across all projects; further
# orders wait strictly in order. 0 = unlimited.
AIWERKSTATT_MAX_PARALLEL_RUNS=5

# Optional knowledge sources for the context pack that new runs get in their
# first message (paths INSIDE the web container — mount the folders read-only,
# see docker-compose.yml). Empty = off.
AIWERKSTATT_KNOWLEDGE_DIR=
AIWERKSTATT_MEMORY_DIR=

# Pauses in seconds before each retry after an API error (not a usage limit).
# Empty = no retry.
AIW_API_RETRY_DELAYS=120,300,900

# Stall guard (on by default; 0 = off): a run that is silent on every axis (no output, no CPU/I/O of its tools, no growing logs, no git,
# no gate progress) is nudged after 15 min, its hung tools are ended after 25 min, and after 40 min it is ended cleanly and
# re-queued at the front with context. Stages in seconds: WK_STALL_GUARD_STAGES=900,1500,2400. Re-queues per task before the
# normal self-healing retry takes over: AIWERKSTATT_STALL_GUARD_MAX.
WK_STALL_GUARD=1
WK_STALL_GUARD_STAGES=
AIWERKSTATT_STALL_GUARD_MAX=2

# Opt-in reading proof: 1 = a new run gets a reading list and must end its result with a
# `READ: <files>` line; a missing line triggers up to AIW_READING_MAX_NUDGES follow-ups.
AIW_READING_PROOF=
AIW_READING_MAX_NUDGES=1
